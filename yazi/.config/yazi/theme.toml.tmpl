title   = { fg = "{{accent}}" }
btn_yes = { fg = "{{bg}}", bg = "{{accent}}", bold = true }
btn_no  = { fg = "{{fg}}" }

[spot]
border = { fg = "{{accent}}" }
title  = { fg = "{{accent}}" }

# Table
tbl_col  = { fg = "{{accent}}" }
tbl_cell = { fg = "{{bg}}", bg = "{{warning}}" }

[notify]
title_info  = { fg = "{{success}}" }
title_warn  = { fg = "{{warning}}" }
title_error = { fg = "{{critical}}" }

[pick]
border   = { fg = "{{accent}}" }
active   = { fg = "{{accent2}}", bold = true }
inactive = { fg = "{{fg}}" }

[input]
border   = { fg = "{{accent}}" }
