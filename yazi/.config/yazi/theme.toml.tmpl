#
# ~/.config/yazi/theme.toml — GENERATED by ~/.local/bin/theme from palettes.toml
#
# Edit theme.toml.tmpl, not this file. The next palette switch overwrites it.
#
# This file cannot be named `*.gen.*` like every other rendered file here: yazi
# reads `theme.toml` at a hardcoded path and takes no include directive, so the
# marker has nowhere to go. It is therefore one of the handful of paths named
# individually in .gitignore. See the block comment there.
#
# A user theme.toml OVERRIDES yazi's preset key by key rather than replacing it,
# so only the keys that carry a colour appear below. Separators, glyph padding
# and the hovered-row indicator are left to the preset — the last of those on
# purpose, because its `reversed = true` inverts against the file's own
# [filetype] colour, which is yazi's signature look and needs no palette.
#
# The two ARRAYS are the exception to that key-by-key merge, and are restated in
# full: `[filetype] rules` and the four `[icon]` tables. See the notes above each.
#
# EVERY KEY BELOW WAS COPIED FROM THE PRESET EMBEDDED IN THE INSTALLED BINARY
# (yazi 26.5.6), and that matters more than it looks. yazi rejects a bad hex, a
# bad value and an unknown [section] loudly — `yazi --debug` exits 1 with a
# caret under the offending token — but an unknown KEY inside a known section is
# ignored in silence, with no warning even in the debug output. That is the same
# failure shape as an undefined GTK @name or an empty tmux `fg=`, so the guard
# is provenance rather than validation: re-derive the keys from the binary, not
# from documentation, if yazi is ever upgraded across a schema change. The
# `[manager]` -> `[mgr]` rename is the precedent.
#
#     strings /usr/bin/yazi | grep -n 'schemas/theme.json'
#
# `[mgr] syntect_theme` is deliberately absent. yazi embeds a tmTheme named
# `ANSI` whose colours are placeholder indices into the 16 terminal slots, and
# uses it when syntect_theme is empty — so preview-pane syntax highlighting
# resolves through the ANSI ramp that [nord.ansi]/[gruvbox.ansi] already give
# kitty and foot. Generating a tmTheme here would define those sixteen colours a
# second time, in parallel, which is the drift this repo exists to stop.

# Chips are given an explicit `fg` of the background role rather than the
# preset's `reversed = true`. Reverse video takes the TERMINAL's colours, not
# the palette's, so a mode chip could read against the wrong ground; naming both
# halves makes it read against its own fill whatever the terminal is doing.

[mgr]
cwd = { fg = "{{accent}}" }

# Find
find_keyword  = { fg = "{{warning}}", bold = true, italic = true, underline = true }
find_position = { fg = "{{accent2}}", bg = "reset", bold = true, italic = true }

# Symlink
symlink_target = { fg = "{{muted}}", italic = true }

# Marker — the thin gutter stripe. fg and bg match so it reads as a solid bar.
marker_copied   = { fg = "{{success}}",   bg = "{{success}}" }
marker_cut      = { fg = "{{critical}}",  bg = "{{critical}}" }
marker_marked   = { fg = "{{indicator}}", bg = "{{indicator}}" }
marker_selected = { fg = "{{warning}}",   bg = "{{warning}}" }

# Count — the badge on the status bar carrying the number of yanked files.
count_copied   = { fg = "{{bg}}", bg = "{{success}}" }
count_cut      = { fg = "{{bg}}", bg = "{{critical}}" }
count_selected = { fg = "{{bg}}", bg = "{{warning}}" }

# Border between the three panes.
border_style = { fg = "{{sel}}" }

[tabs]
active   = { fg = "{{bg}}", bg = "{{accent}}", bold = true }
inactive = { fg = "{{fg}}", bg = "{{surface}}" }

[mode]
normal_main = { fg = "{{bg}}",      bg = "{{accent}}", bold = true }
normal_alt  = { fg = "{{accent}}",  bg = "{{surface}}" }

# Select mode
select_main = { fg = "{{bg}}",      bg = "{{success}}", bold = true }
select_alt  = { fg = "{{success}}", bg = "{{surface}}" }

# Unset mode — removing from a selection, so it takes the danger role.
unset_main = { fg = "{{bg}}",       bg = "{{critical}}", bold = true }
unset_alt  = { fg = "{{critical}}", bg = "{{surface}}" }

[status]
# Permissions, read left to right in the status bar: rwx each get the role that
# matches what going wrong with it would cost.
perm_sep   = { fg = "{{muted}}" }
perm_type  = { fg = "{{accent2}}" }
perm_read  = { fg = "{{warning}}" }
perm_write = { fg = "{{critical}}" }
perm_exec  = { fg = "{{success}}" }

# Progress
progress_label  = { fg = "{{fg_bright}}", bold = true }
progress_normal = { fg = "{{accent}}",    bg = "{{surface}}" }
progress_error  = { fg = "{{critical}}",  bg = "{{surface}}" }

[which]
mask            = { bg = "{{surface}}" }
cand            = { fg = "{{indicator}}" }
rest            = { fg = "{{muted}}" }
desc            = { fg = "{{accent2}}" }
separator_style = { fg = "{{muted}}" }

[confirm]
