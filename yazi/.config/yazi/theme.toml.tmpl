run     = { fg = "{{accent2}}" }
desc    = { fg = "{{fg}}" }
hovered = { fg = "{{bg}}", bg = "{{accent}}", bold = true }
footer  = { fg = "{{bg}}", bg = "{{fg}}" }

# File-specific styles.
#
# `rules` is an array, and an array REPLACES the preset's rather than merging
# with it — so every rule yazi ships has to be restated here, including the
# fallbacks at the bottom. Dropping one is silent: files simply stop being
# coloured, which looks like a palette that could not be bothered rather than a
# rule that went missing.
[filetype]
rules = [
	# Image
	{ mime = "image/*", fg = "{{warning}}" },
	# Media
	{ mime = "{audio,video}/*", fg = "{{accent2}}" },
	# Archive
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{critical}}" },
	# Document
	{ mime = "application/{pdf,doc,rtf}", fg = "{{accent}}" },
	# Virtual file system — an entry yazi knows of but cannot currently reach.
	{ mime = "vfs/{absent,stale}", fg = "{{muted}}" },
	# Special file
	{ url = "*", is = "orphan", fg = "{{bg}}", bg = "{{critical}}" },
	{ url = "*", is = "exec"  , fg = "{{success}}" },
	# Dummy file
	{ url = "*",  is = "dummy", fg = "{{bg}}", bg = "{{critical}}" },
	{ url = "*/", is = "dummy", fg = "{{bg}}", bg = "{{critical}}" },
	# Fallback: directories. Last, because the rules above are more specific.
	{ url = "*/", fg = "{{accent2}}" }
]

# Icons.
#
# yazi's preset ships 725 icon rules and paints every one of them from the
# Material palette — #03a9f4, #ffc107, #f44336. Those are a third colour scheme,
# fixed in the binary, matching neither Nord nor Gruvbox and not moving when the
# palette does. Left alone they put rainbow glyphs beside filenames this repo
# has gone to some trouble to colour from one table, and the clash is worst
# against Nord, which is the more muted of the two.
#
# So the four arrays are replaced. **`dirs`, `files`, `exts` and `conds` REPLACE
# the preset when spelled bare** — only `prepend_*`/`append_*` merge — which is
# the same trap as `[filetype] rules` above, and it cuts both ways here: it is
# what makes a clean sweep possible, and it is why the fallbacks at the end of
# `conds` must be restated or every unmatched file loses its icon silently.
#
# The trade accepted, so nobody has to rediscover it: 725 rules become 171, and
# an extension outside that set falls through to the generic file icon instead
# of getting a bespoke one. That is the README's "granularity loses" applied to
# icons — a table small enough to read in one screen, at the cost of not
# knowing what a .3mf file is. Extending it is adding a line to a bucket.
#
# Colour is by BUCKET, never per-format: everything you edit is `accent`,
# everything that configures something is `indicator`, byproducts are `muted`.
# Two files of the same kind therefore cannot drift apart, which is the same
# argument the palette table makes one level up. The buckets deliberately echo
# `[filetype]` above — images `warning`, media `accent2`, archives `critical`,
# executables `success` — so a row's glyph and its filename agree rather than
# arguing.
#
# Glyphs are lifted from the preset in the installed binary rather than chosen
# by hand, so each is one yazi already expects the Nerd Font to carry; the few
# names the preset lacks borrow a sibling's glyph. Regenerate the same way after
# an upgrade — see the header at the top of this file.
#
# `files` keys are lowercase: yazi folds the filename before matching, and the
# preset lists `dockerfile`, `makefile` and `license` that way. A capitalised
# key here would simply never match, with no error.
[icon]
globs = []

dirs = [
