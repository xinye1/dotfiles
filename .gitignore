# Claude Code local state (machine-specific permissions, absolute paths)
.claude/settings.local.json

# htop writes htoprc via mkstemp+rename inside the folded package dir; a killed
# htop can leave the temp file behind
htop/.config/htop/htoprc.tmp.*

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Theme state, and the pointers derived from it.
#
# Which palette is applied is a property of this machine right now, not of the
# configuration, so `theme <name>` must be an operational change and never a git
# one. `.theme` holds the one word; every path below is a symlink `theme`
# (re)points at that palette's fragment, and recreates from scratch on a clone.
#
# Listed one by one because the names are semantic, not lexical — no glob catches
# `colors.css`, `.gtkrc-2.0` and `theme.env` without also catching tracked files.
# tests/theme_test.sh fails if this list falls behind the fragments on disk.
.theme
alacritty/.config/alacritty/colors.toml
foot/.config/foot/colors.ini
fuzzel/.config/fuzzel/colors.ini
gtk/.config/gtk-3.0/gtk.css
gtk/.config/gtk-3.0/settings.ini
gtk/.config/gtk-4.0/gtk.css
gtk/.config/gtk-4.0/settings.ini
gtk/.config/xsettingsd/xsettingsd.conf
gtk/.gtkrc-2.0
gtklock/.config/gtklock/colors.css
mako/.config/mako/colors
nwg-drawer/.config/nwg-drawer/colors.css
sway/.config/sway/colors.conf
sway/.config/sway/theme.env
vim/.vim/colorscheme.vim
waybar/.config/waybar/colors.css
waybar/.config/waybar/colors.json
