#!/usr/bin/env bash
#
# tp-backup — restic backup regime for the trading-platform-v2 box.
#
#   tp-backup daily        git capture + vault snapshot   (Tier 2 + Tier 3)
#   tp-backup substrate    research substrate snapshot    (Tier 4)
#   tp-backup media        irreplaceable media snapshot   (Tier 5)
#   tp-backup check        repository integrity  (--read-data for the full read)
#   tp-backup rehearsal    restore-into-scratch proof: restores the latest vault
#                          snapshot into a private temp dir and checks it against
#                          the REPOSITORY -- never against live, which changes
#                          hourly and would mismatch every run. Nothing under
#                          $HOME is touched, so it is safe to run at any time and
#                          cannot overwrite work newer than the snapshot.
#          …  --ssd        the same drill against the cold SSD leg (disk attached)
#   tp-backup status       staleness of every tier
#
# Design notes that are NOT incidental:
#   * The repository is reached with an APPEND-ONLY key. This process cannot
#     delete backup data (proved 2026-08-25: server returns 403 on Remove).
#     Pruning requires the maintenance key and is deliberately not automated.
#   * Nothing here uses `|| true`. A masked failure is how the 2026-08-25
#     outage stayed invisible for a day.
#   * "Nothing to capture" is success. "Capture failed" is an alert. They are
#     never conflated (finding F11).
#   * Raw Sharadar data (trading-platform-v2 issue 752, Personal Use licence)
#     must never enter a snapshot -- this repository is APPEND-ONLY, so there
#     is no way to take it back out once written. LICENCE_EXCLUDES below is
#     spliced into every `restic_ro backup` call, which itself refuses to run
#     without it; git_capture() separately refuses any untracked file under
#     $HOME/data/sharadar or a `.sharadar-licence-extract`-marked directory.
#
# `-E` is load-bearing, not decoration. Without it bash does NOT inherit the ERR
# trap into shell functions ("The ERR trap is normally not inherited in such
# cases" -- bash(1)), so die() never ran for an unguarded failure inside
# git_capture(): the script exited with the raw status of the failing command,
# silently, sending no alert of its own. Measured 2026-08-28..09-03 -- eight
# consecutive daily runs exited 128 with no `tp-backup: FAILED:` line anywhere.
set -Eeuo pipefail

# Absolute path to this script, resolved once: cmd_daily re-invokes it as a child
# process (see __capture) and must not depend on $0 or on the caller's PATH.
TPB_SELF="$(readlink -f "${BASH_SOURCE[0]}")"

CONF="${TPB_CONF:-$HOME/.config/tp-backup/config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tp-backup"
LOCKDIR="$STATE/locks"

[[ -r "$CONF" ]] || { echo "tp-backup: no readable config at $CONF" >&2; exit 1; }
# shellcheck disable=SC1090
source "$CONF"
mkdir -p "$STATE" "$LOCKDIR" "$STATE/git-capture"

# Resolved once, used by both restic_ro()'s LICENCE_EXCLUDES (below) and
# git_capture()'s own refusal to tar a path under here (issue 752). Falls back
# to the literal path if it does not exist yet -- readlink -f on a missing leaf
# still normalises the existing prefix, and the comparison only needs a stable
# absolute path, not an existing one.
TPB_SHARADAR_ROOT="$(readlink -f "$HOME/data/sharadar" 2>/dev/null || printf '%s' "$HOME/data/sharadar")"

# ── the SSD cold-storage leg ────────────────────────────────────────────────
# Read AFTER the config so either may be overridden there. 30 days: this leg is
# deliberately cold — normally detached, refreshed by hand — so it trades a wider
# loss window for not nagging. The two online legs carry the daily risk.
SSD_REPO="${TPB_SSD_REPO:-/mnt/ext/backups/tp2-restic}"
SSD_MAX_H="${TPB_SSD_MAX_H:-720}"

# ── alerting ────────────────────────────────────────────────────────────────
# Self-contained by design: no repo checkout, no repo .env (finding F10).
notify() {
    local title="$1" msg="$2" prio="${3:-default}"
    [[ -n "${NTFY_TOPIC:-}" ]] || { echo "tp-backup: NTFY_TOPIC unset — alert NOT delivered: $title" >&2; return 1; }
    curl -fsS -m 20 \
        -H "Title: ${title//$'\n'/ }" -H "Priority: $prio" \
        -d "${msg//$'\n'/ }" "${NTFY_SERVER:-https://ntfy.sh}/$NTFY_TOPIC" >/dev/null
}
# Any scratch dir holding restored (decrypted) material registers itself here so
# that BOTH the normal path and die() destroy it. A RETURN trap does not fire on
# exit, which would have left .ssh/.env material lying in the clear after a failure.
TPB_SCRATCH=""
_scrub() { [[ -n "$TPB_SCRATCH" && -d "$TPB_SCRATCH" ]] || return 0
           find "$TPB_SCRATCH" -type f -exec shred -u {} + 2>/dev/null || true
           rm -rf "$TPB_SCRATCH"; TPB_SCRATCH=""; }
trap _scrub EXIT
die() { _scrub; echo "tp-backup: FAILED: $*" >&2; notify "Backup FAILED" "$*" urgent || true; exit 1; }
trap 'die "unexpected error at line $LINENO"' ERR

# ── restic plumbing ─────────────────────────────────────────────────────────
SSH_BASE="ssh -p ${TPB_SSH_PORT} -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=30"

# ── Sharadar licence: raw vendor data must never enter the backup repo ──────
# Personal Use licence: within 30 days of cancelling, ALL raw Sharadar data
# (downloads, bulk files, caches, extracts) must be deleted. This repository is
# APPEND-ONLY (server returns 403 on Remove, proved 2026-08-25) and this box has
# no maintenance key to prune it, so raw Sharadar data must never be written
# into a snapshot in the first place -- there is no way to take it back out.
# Every WS2 extract root carries the `.sharadar-licence-extract` marker and a
# CACHEDIR.TAG (trading-platform-v2 issue 752). One array, spliced into every
# `restic_ro backup` call below, so a future tier only has to add
# "${LICENCE_EXCLUDES[@]}" once. `_assert_licence_excludes` is the belt to that
# brace: it refuses (loudly, via die()) to run any `restic_ro backup` whose
# argv does not carry every entry, so an edit that drops it from an existing
# call -- or a new call that forgets it -- fails the run instead of silently
# writing raw vendor data into a repository that cannot be pruned.
LICENCE_EXCLUDES=(
    --exclude "$HOME/data/sharadar"
    --exclude-if-present .sharadar-licence-extract
    --exclude-caches
)

_assert_licence_excludes() {
    local want arg found
    for want in "${LICENCE_EXCLUDES[@]}"; do
        found=0
        for arg in "$@"; do [[ "$arg" == "$want" ]] && { found=1; break; }; done
        (( found )) || die "restic_ro backup call is missing Sharadar licence exclude '$want' — refusing to run (issue 752)"
    done
}

restic_ro() {   # append-only key: backup, check, list. Cannot delete.
    [[ "${1:-}" == "backup" ]] && _assert_licence_excludes "$@"
    env -u SSH_AUTH_SOCK "$TPB_RESTIC" \
        -o rclone.program="$SSH_BASE -i $TPB_KEY_BACKUP $TPB_HOST" \
        -o rclone.args="forced-by-authorized-keys" \
        -r rclone: --password-file "$TPB_PASSWORD_FILE" "$@"
}
restic_rw() {   # maintenance key: prune/forget. Needs the agent (passphrase).
    "$TPB_RESTIC" \
        -o rclone.program="$SSH_BASE -i $TPB_KEY_MAINT $TPB_HOST" \
        -o rclone.args="rclone serve restic --stdio $TPB_REPO_PATH" \
        -r rclone: --password-file "$TPB_PASSWORD_FILE" "$@"
}

stamp() { date +%s > "$STATE/last-success-$1"; }

# ── Tier 2: work in flight, per WORKING TREE not per repo (finding R8) ──────
git_capture() {
    local out="$STATE/git-capture" repo tree name n_unpushed dirty
    rm -rf "${out:?}/current"; mkdir -p "$out/current"

    for repo in "$HOME"/repos/*/; do
        [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
        # Every working tree, including .claude/worktrees/* which are gitignored
        # and therefore invisible to an untracked-file sweep.
        while read -r tree; do
            [[ -n "$tree" ]] || continue
            # Name must identify the REPO as well as the tree: two repos can hold
            # same-named worktrees (both use .claude/worktrees/), and a bare tree
            # name would let one silently overwrite the other.
            if [[ "$tree" == "${repo%/}" ]]; then
                name="$(basename "${repo%/}")"
            else
                name="$(basename "${repo%/}")__$(basename "$tree")"
            fi
            local d="$out/current/$name"; mkdir -p "$d"

            # A worktree that is REGISTERED but absent from disk is a state, not an
            # error -- the same call the "no initial commit" branch below makes.
            # Agent sessions create worktrees under their scratchpad in /tmp, which
            # is tmpfs: the next reboot empties it while the registration survives
            # in <repo>/.git/worktrees/<name>. `git -C <gone> status` then exits 128
            # and took the ENTIRE daily run down with it -- before the vault
            # snapshot -- for eight days (2026-08-28..09-03, dotfiles/df-ssd).
            # Curing it needs `git worktree prune`, which is a mutation of the
            # user's repo and deliberately NOT something a backup process does.
            if [[ ! -d "$tree" ]]; then
                printf 'registered in %s but absent from disk.\nStale registration -- cure with: git -C %s worktree prune\n' \
                    "${repo%/}/.git/worktrees" "${repo%/}" > "$d/MISSING_WORKTREE"
                echo "tp-backup: stale worktree registration in ${repo%/}: $tree (nothing to capture; run 'git worktree prune')" >&2
                continue
            fi

            git -C "$tree" status --porcelain=v1 > "$d/status.txt"
            git -C "$tree" rev-parse --abbrev-ref HEAD > "$d/branch.txt" 2>/dev/null || echo "DETACHED" > "$d/branch.txt"

            # A tree with no initial commit has no HEAD: `git log` and `git diff HEAD`
            # both exit non-zero, and `set -e` would abort the entire daily run before
            # the vault snapshot. Handle it as a state, not an error.
            if ! git -C "$tree" rev-parse --verify -q HEAD >/dev/null; then
                echo "NO_COMMITS" > "$d/log.txt"
                git -C "$tree" diff --cached > "$d/staged.patch" || true
                : > "$d/uncommitted.none"; : > "$d/unpushed.none"
                continue
            fi
            git -C "$tree" log --oneline -5 > "$d/log.txt"

            # --all covers detached HEAD and every worktree branch; --branches does not.
            # `|| echo 0` would report a broken repo as "nothing to capture" -- the exact
            # conflation this capture exists to avoid. Fail loudly instead.
            n_unpushed=$(git -C "$tree" rev-list --count --all --not --remotes 2>/dev/null) \
                || die "git rev-list failed in $tree — cannot tell unpushed work from none"
            if [[ "$n_unpushed" -gt 0 ]]; then
                git -C "$tree" bundle create "$d/unpushed.bundle" --all --not --remotes >/dev/null 2>&1 \
                    || die "git bundle failed in $tree ($n_unpushed unpushed commits)"
            else
                echo "clean: no commits absent from remotes" > "$d/unpushed.none"
            fi

            git -C "$tree" diff HEAD > "$d/uncommitted.patch"
            [[ -s "$d/uncommitted.patch" ]] || { rm -f "$d/uncommitted.patch"; echo none > "$d/uncommitted.none"; }

            # Sharadar licence (issue 752): refuse to tar any untracked file under
            # $HOME/data/sharadar or under a directory carrying the
            # `.sharadar-licence-extract` marker, even though the WS2-side guard
            # (assert_extract_root) is supposed to make either impossible from the
            # WS2 side already -- this does not rely on that alone. SKIP with a
            # logged count, not a fail: one contaminated worktree must not cost the
            # vault snapshot for every other repo (same "capture failure must not
            # kill the vault" reasoning as the MISSING_WORKTREE case above), and the
            # count (never the paths or contents) is what a human needs to notice
            # something was withheld.
            local skip_n=0 rel abs skip md
            local -a keep=()
            while IFS= read -r -d '' rel; do
                abs="$tree/$rel"
                skip=0
                case "$(readlink -f "$abs" 2>/dev/null || printf '%s' "$abs")" in
                    "$TPB_SHARADAR_ROOT"/*|"$TPB_SHARADAR_ROOT") skip=1 ;;
                esac
                if (( ! skip )); then
                    md="$(dirname "$abs")"
                    while :; do
                        [[ -e "$md/.sharadar-licence-extract" ]] && { skip=1; break; }
                        [[ "$md" == "$tree" ]] && break
                        md="$(dirname "$md")"
                    done
                fi
                # NOT `(( skip_n++ ))`: when skip_n is 0 the post-increment's VALUE
                # is 0, and `((...))` treats a zero result as failure -- exit 1,
                # caught by the ERR trap under `-E`, die() on the very first skip.
                if (( skip )); then skip_n=$(( skip_n + 1 )); else keep+=("$rel"); fi
            done < <(git -C "$tree" ls-files --others --exclude-standard -z)

            if (( skip_n > 0 )); then
                echo "tp-backup: git-capture: skipped $skip_n untracked file(s) under a Sharadar licence path in $tree (never captured)" >&2
            fi

            if (( ${#keep[@]} > 0 )); then
                (cd "$tree" && printf '%s\0' "${keep[@]}" \
                    | tar --null -T - -czf "$d/untracked.tar.gz" 2>/dev/null) \
                    || die "untracked capture failed in $tree"
            else
                echo none > "$d/untracked.none"
            fi
        done < <(git -C "$repo" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
    done
    echo "$(date -Is)" > "$out/current/CAPTURED_AT"
    stamp git-capture
}

# ── Tier 3: the vault ───────────────────────────────────────────────────────
cmd_daily() {
    # The vault snapshot is the tier that actually protects this machine; the git
    # capture is a convenience layered on top of it. Letting a capture failure
    # abort the run cost eight days of backups (2026-08-28..09-03): one dead
    # worktree registration in an UNRELATED repo exited 128 under `set -e` before
    # restic was ever reached, and the vault silently stopped.
    #
    # The capture runs as a CHILD PROCESS rather than `git_capture || rc=$?`.
    # Calling it in a tested context switches errexit off for its whole body
    # (bash(1): in "a context where -e is being ignored ... none of the commands
    # executed within the ... function body will be affected by the -e setting"),
    # which would turn every unguarded failure in there into a silent skip --
    # exactly the masked failure this script refuses to have. A child re-enters
    # with `set -Eeuo pipefail` armed, keeps its own die()/ERR trap, and hands
    # back a plain exit status.
    local capture_rc=0
    "$TPB_SELF" __capture </dev/null || capture_rc=$?

    # Glob into an array: unquoted command substitution word-splits on spaces and
    # leaves a literal unmatched glob when no .env exists.
    local -a _envs=()
    local _e; for _e in "$HOME"/repos/*/.env; do [[ -e "$_e" ]] && _envs+=("$_e"); done
    restic_ro backup --tag vault --tag daily \
        "${LICENCE_EXCLUDES[@]}" \
        --exclude "$HOME/.claude/plugins" \
        --exclude "$HOME/.claude/jobs" \
        --exclude "$HOME/.claude/file-history" \
        --exclude "$HOME/.claude/shell-snapshots" \
        --exclude "$HOME/.claude/paste-cache" \
        --exclude "$HOME/.claude/image-cache" \
        --exclude "$HOME/.claude/cache" \
        --exclude "$HOME/.local/state/tp2-watchdogs/logs" \
        "$HOME/.claude" "$HOME/.claude.json" \
        "$HOME/.ssh" "$HOME/.gnupg" "$HOME/.config/gh" "$HOME/.config/rclone" \
        "$HOME/.config/systemd/user" "$HOME/.config/tp-backup" "$HOME/.config/jellyfin-roles" \
        "$HOME/.local/opt/tp2-watchdogs" "$HOME/.local/state/tp2-watchdogs" \
        "$STATE/git-capture" \
        "$HOME/archives" "$HOME/db-backups" \
        "${_envs[@]}"
    stamp vault

    # Fail AFTER the snapshot, never instead of it. The unit still goes red and
    # the alert still fires -- but the machine is backed up either way. The
    # message says so explicitly, so a red unit is never read as "no backup".
    #
    # Deliberately NOT die(): the child has already sent its own notification
    # naming the actual error, and systemd's OnFailure= sends the urgent one, so
    # die() here would make three alerts for one fault. Alert fatigue is a real
    # failure mode for this regime -- eight days of nightly alerts that said
    # nothing is how the outage survived -- and a channel worth reading is one
    # that does not repeat itself. The journal line below is the durable record.
    if (( capture_rc != 0 )); then
        echo "tp-backup: FAILED: git capture failed (rc=$capture_rc) -- the vault snapshot WAS still taken" >&2
        exit 1
    fi
}

# ── Tier 4: substrate, guarded against torn capture (finding R13) ───────────
# The writer takes the lock; absence of the lock is EVIDENCE, not an assumption.
cmd_substrate() {
    # HOLD the lock for the whole backup. Merely testing for it is a TOCTOU race:
    # a sweep starting one second later would write into the tree mid-snapshot.
    local lock="$LOCKDIR/substrate-writer.lock" lockfd
    exec {lockfd}>"$lock" || die "cannot open substrate lock $lock"
    if ! flock -n "$lockfd"; then
        echo "tp-backup: substrate writer holds the lock — SKIPPED, not failed" >&2
        date +%s > "$STATE/last-skip-substrate"
        exec {lockfd}>&-
        return 0
    fi
    local V="$HOME/repos/trading-platform-v2/research"
    local S="$HOME/repos/tp2-signal-home/research"

    # WS2's EODHD-era edge-search cache (36 GB as of 2026-09-26). Confirmed by
    # WS2 (issue 752) to hold no raw Sharadar data or extract, now or by design
    # -- every Sharadar extract lives under $TPB_SHARADAR_ROOT instead, and
    # LICENCE_EXCLUDES applies here too as defence in depth. It cannot be
    # re-downloaded (the EODHD vendor relationship that produced it is retired),
    # so it gets the same refusal cmd_media() gives its own irreplaceable
    # source: missing or present-but-empty must DIE, never silently snapshot a
    # vacuous state as a "success" (an ordinary `restic backup` on an empty
    # directory exits 0 and records a real, if pointless, snapshot -- it is not
    # this guard's job to rely on restic to notice that for us).
    local WS2_CACHE="$V/ws2_edge/.cache_ws2"
    [[ -d "$WS2_CACHE" ]] || die "substrate source $WS2_CACHE missing"
    local n_ws2
    n_ws2=$(find "$WS2_CACHE" -type f -printf . 2>/dev/null | wc -c)
    (( n_ws2 > 0 )) || die "substrate source $WS2_CACHE is present but empty — refusing to snapshot a vacuous state"

    local -a srcs=(
        "$V/midsmall_edge_search/.cache_snapshots"
        "$V/midsmall_edge_search/.cache_midsmall_sealed_ecc5481f"
        "$V/midsmall_edge_search/.cache"
        "$V/holistic_ml_trading/results"
        "$S/midsmall_edge_search/.cache_midsmall"
        "$S/midsmall_edge_search/.cache"
        "$S/midsmall_edge_search/bronze"
        "$S/holistic_ml_trading/results"
        "$S/holistic_ml_trading/.cache_holistic"
        "$WS2_CACHE"
    )

    # LICENCE_EXCLUDES carries --exclude-caches, which makes restic skip the
    # CONTENTS of any directory holding a valid CACHEDIR.TAG while still
    # exiting 0. None of these sources carried one on 2026-09-26, so a tag
    # appearing inside one later would silently hollow out this tier's
    # snapshot -- a green run that backed up nothing there. Refuse instead: a
    # tag here is either a tool's cache that should not be in a substrate
    # source, or a Sharadar extract root that must not be under one at all,
    # and both need a human (CodeRabbit finding on dotfiles PR 35).
    local src tag
    for src in "${srcs[@]}"; do
        [[ -d "$src" ]] || continue
        tag="$(find "$src" -name CACHEDIR.TAG -print -quit 2>/dev/null)"
        [[ -z "$tag" ]] || die "substrate source $src contains a CACHEDIR.TAG ($tag) -- --exclude-caches would silently drop that subtree; refusing"
    done

    restic_ro backup --tag substrate --tag weekly \
        "${LICENCE_EXCLUDES[@]}" \
        "${srcs[@]}"
    stamp substrate
    exec {lockfd}>&-
}

# ── Tier 5: irreplaceable media ─────────────────────────────────────────────
# /mnt/ext holds ~450 GB, almost all of it re-downloadable films and TV that is
# deliberately NOT backed up. recordings/ is the exception: camera originals
# that exist nowhere else, on a single exFAT drive with no redundancy and no
# checksums.
cmd_media() {
    # Overridable only so the guards below can be exercised against a scratch
    # directory; unset, they are the real paths.
    local SRC="${TPB_MEDIA_SRC:-/mnt/ext/films/general/recordings}"
    local MNT="${TPB_MEDIA_MOUNT:-/mnt/ext}"

    # An unmounted drive must SKIP, never snapshot. /mnt/ext is an ordinary
    # directory when the disk is detached, so restic would happily record a
    # snapshot in which every file had been deleted -- the tier would report
    # green while protecting nothing, and the stamp would suppress the watchdog
    # that is supposed to catch exactly this. A skip leaves the stamp alone, so
    # the tier ages and the watchdog speaks up.
    if ! mountpoint -q "$MNT"; then
        echo "tp-backup: $MNT not mounted — media SKIPPED, not failed" >&2
        date +%s > "$STATE/last-skip-media"
        return 0
    fi
    [[ -d "$SRC" ]] || die "media source $SRC missing while $MNT IS mounted"

    # Mounted but empty is not a normal state; it is either the wrong disk or a
    # deletion. Refuse rather than record it.
    local n
    n=$(find "$SRC" -type f -printf . 2>/dev/null | wc -c)
    (( n > 0 )) || die "media source $SRC is mounted but empty — refusing to snapshot a vacuous state"

    restic_ro backup --tag media --tag weekly "${LICENCE_EXCLUDES[@]}" "$SRC"
    stamp media
}

# ── SSD cold-storage freshness ──────────────────────────────────────────────
# Records how far behind the cold leg is, so the reminder survives the disk being
# absent. The design doc claimed the box "cannot watch this leg at all"; that was
# too strong and is corrected here. What it cannot do is verify the CONTENTS of a
# disk that is not present. The AGE of the last sync is a fact it can hold on its
# own, and that is the fact the operator needs.
#
# When the disk is attached, the newest snapshot ON THE DISK is the truth and is
# recorded. When it is absent, the last recorded value stands and simply ages.
# Reading needs no root: the repo is world-readable and `--no-lock` avoids the
# write that a lock would require.
ssd_stamp_refresh() {
    [[ -r "$SSD_REPO/config" ]] || return 0          # not attached, or no repo there
    local newest
    newest=$("$TPB_RESTIC" -r "$SSD_REPO" --password-file "$TPB_PASSWORD_FILE" --no-lock \
                 snapshots --json 2>/dev/null \
             | python3 -c 'import json,sys
d = json.load(sys.stdin)
print(max(s["time"] for s in d) if d else "")' 2>/dev/null) || return 0
    [[ -n "$newest" ]] || return 0
    date -d "$newest" +%s > "$STATE/last-success-ssd" 2>/dev/null || true
}

# A reminder, NOT a failure. A detached cold disk is the design working, so this
# never fails the unit and never raises priority -- the whole point of a cold leg
# is that its absence is normal. Making it red daily would train the operator to
# ignore the channel, which is exactly how the 08-28 outage stayed unread.
ssd_reminder() {
    local now age_h last mounted msg
    now=$(date +%s)
    ssd_stamp_refresh
    if [[ -r "$SSD_REPO/config" ]]; then mounted="The disk is attached now — just run the sync."
    else                                 mounted="Attach the disk first, then run the sync."; fi

    if [[ -r "$STATE/last-success-ssd" ]]; then
        last=$(<"$STATE/last-success-ssd"); age_h=$(( (now - last) / 3600 ))
        (( age_h > SSD_MAX_H )) || return 0
        msg="SSD cold-storage leg is $(( age_h / 24 ))d old (reminder threshold $(( SSD_MAX_H / 24 ))d). $mounted"
    else
        msg="SSD cold-storage leg has never been recorded. $mounted"
    fi
    echo "tp-backup: $msg" >&2
    notify "Backup: check the SSD" "$msg  ->  sudo ~/.local/bin/tp-backup-ssd sync" default || true
}

# Read-only view of the cold leg. No root: the repo is world-readable and
# `--no-lock` avoids the write a lock would need, so the drill can run while the
# disk is merely attached rather than being administered.
restic_ssd() {
    "$TPB_RESTIC" -r "$SSD_REPO" --password-file "$TPB_PASSWORD_FILE" --no-lock "$@"
}

# ── weekly restore rehearsal: proof that a snapshot is RESTORABLE ───────────
# Deliberately does NOT compare against live. Memories change constantly, so a
# snapshot-vs-live diff mismatches every day and trains you to ignore the alert.
# What matters is the round trip: the snapshot restores, the file count matches
# what the snapshot itself claims, and the bytes match what restic holds.
#
# `--ssd` runs the identical drill against the cold leg. Same code, different
# repository, on purpose: a restore path proven only against Hetzner says nothing
# about the disk, and the disk is the copy you reach for when Hetzner is the
# thing you have lost.
#
# NOTHING LIVE IS EVER TOUCHED. The restore target is a fresh mktemp under
# XDG_RUNTIME_DIR at mode 0700, shredded on the way out by _scrub -- so this can
# be run at any time, and it cannot overwrite work newer than the snapshot,
# because it never writes anywhere near $HOME. Correctness is judged against the
# REPOSITORY (the snapshot's own file count, and a byte-for-byte `dump` of one
# file), never against live state, which changes hourly and would mismatch every
# single run until the operator learned to ignore it.
cmd_rehearsal() {
    local scratch snap n_snap n_rest probe live_sha rest_sha
    local repo=restic_ro label=Hetzner tier=rehearsal

    # An unrecognised argument must NOT fall through to the Hetzner drill.
    # `rehearsal --sdd` used to print "rehearsal(Hetzner) OK" and exit 0, so a
    # mistyped flag reported a green cold-leg drill against a repository it had
    # never opened -- and you mistype it exactly when doing the rare, unfamiliar
    # operation. That is this regime's signature failure (a success signal
    # detached from what was actually verified), so the parse is exhaustive.
    case $# in
        0) ;;
        1) [[ "$1" == "--ssd" ]] || {
               echo "tp-backup: rehearsal: unknown argument '$1' (expected '--ssd' or nothing)" >&2
               exit 2; }
           repo=restic_ssd; label=SSD; tier=rehearsal-ssd
           [[ -r "$SSD_REPO/config" ]] \
               || die "rehearsal --ssd: no repository at $SSD_REPO — attach the disk first" ;;
        *) echo "tp-backup: rehearsal: too many arguments (expected '--ssd' or nothing)" >&2
           exit 2 ;;
    esac

    scratch=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}" tp-rehearsal-XXXXXX)   # 0700
    TPB_SCRATCH="$scratch"   # destroyed by _scrub on EXIT *and* by die()

    snap=$("$repo" snapshots --tag vault --json 2>/dev/null \
           | python3 -c 'import json,sys; print(json.load(sys.stdin)[-1]["short_id"])')
    [[ -n "$snap" ]] || die "rehearsal($label): no vault snapshot found"

    # What the snapshot says it holds.
    n_snap=$("$repo" ls "$snap" 2>/dev/null | grep -c '/memory/.*\.md$') || true
    (( n_snap > 0 )) || die "rehearsal($label): snapshot $snap contains no memory files — wrong snapshot or broken index"

    "$repo" restore "$snap" --target "$scratch" \
        --include "$HOME/.claude/projects" >/dev/null \
        || die "rehearsal($label): restore failed for snapshot $snap"

    n_rest=$(find "$scratch$HOME/.claude/projects" -path '*/memory/*.md' -type f 2>/dev/null | wc -l)
    (( n_rest == n_snap )) \
        || die "rehearsal($label): $snap claims $n_snap memory files, restore produced $n_rest"

    # Byte-level round trip on one file, straight from the repository.
    # `| head -1` would close the pipe, SIGPIPE the upstream, and pipefail would
    # abort with 141 -- the same trap the untracked-file capture hit. Read the list.
    local -a _files=()
    mapfile -t _files < <(find "$scratch$HOME/.claude/projects" -path '*/memory/*.md' -type f | sort)
    probe="${_files[0]:-}"
    [[ -n "$probe" ]] || die "rehearsal($label): no probe file after restore"
    rest_sha=$(sha256sum "$probe" | cut -d" " -f1)
    live_sha=$("$repo" dump "$snap" "${probe#"$scratch"}" 2>/dev/null | sha256sum | cut -d" " -f1)
    [[ -n "$live_sha" && "$rest_sha" == "$live_sha" ]] \
        || die "rehearsal($label): byte mismatch on ${probe#"$scratch"} (restored=${rest_sha:0:16} repo=${live_sha:0:16})"

    echo "tp-backup: rehearsal($label) OK — $snap restored $n_rest/$n_snap memory files; probe sha ${rest_sha:0:16} matches the repository"
    stamp "$tier"
    _scrub
}

cmd_check()  { if [[ "${1:-}" == "--read-data" ]]; then restic_ro check --read-data; else restic_ro check; fi; stamp check; }

cmd_status() {
    local now name last age
    now=$(date +%s)
    ssd_stamp_refresh            # so `status` reflects the disk if it is attached
    printf '%-14s %-10s %s\n' TIER AGE LAST-SUCCESS
    for name in vault git-capture jellyfin substrate media check rehearsal ssd rehearsal-ssd; do
        if [[ -r "$STATE/last-success-$name" ]]; then
            last=$(<"$STATE/last-success-$name"); age=$(( (now - last) / 3600 ))
            printf '%-14s %-10s %s\n' "$name" "${age}h" "$(date -d "@$last" '+%Y-%m-%d %H:%M')"
        else
            printf '%-14s %-10s %s\n' "$name" never -
        fi
    done
    # The cold leg's row is the age of the copy, not of a run, so say whether the
    # disk is here: an unattached disk explains an old row and is not a fault.
    if [[ -r "$SSD_REPO/config" ]]; then echo "  (ssd: disk attached; cold-storage reminder at $(( SSD_MAX_H / 24 ))d)"
    else                                 echo "  (ssd: disk NOT attached — normal; cold-storage reminder at $(( SSD_MAX_H / 24 ))d)"; fi
}

# ── staleness watchdog: alerts on ABSENCE, not on error ─────────────────────
# A failure alert cannot fire for a run that never happened — an expired
# credential, a disabled timer, a laptop shut for a fortnight. This can.
cmd_watchdog() {
    local now name last age_h thr stale=() ; now=$(date +%s)
    # tier:threshold_hours
    for spec in vault:36 git-capture:36 jellyfin:36 substrate:240 media:240 check:240 rehearsal:240; do
        name="${spec%%:*}"; thr="${spec##*:}"
        if [[ -r "$STATE/last-success-$name" ]]; then
            last=$(<"$STATE/last-success-$name"); age_h=$(( (now - last) / 3600 ))
            (( age_h > thr )) && stale+=("$name ${age_h}h (limit ${thr}h)")
        else
            stale+=("$name NEVER RUN")
        fi
    done
    # The cold leg is checked SEPARATELY and on its own terms: it is a reminder at
    # default priority that never fails the unit, because a detached disk is the
    # design working rather than a fault. Folding it into `stale` would make the
    # watchdog red for weeks at a time and teach the operator to ignore the one
    # alert that still works when everything else has gone quiet.
    ssd_reminder

    if (( ${#stale[@]} )); then
        printf 'tp-backup: STALE: %s\n' "${stale[*]}" >&2
        notify "Backup STALE" "${stale[*]}" high
        return 1
    fi
    echo "tp-backup: all tiers within threshold"
}

case "${1:-}" in
    daily)     cmd_daily ;;
    # Internal, not in the usage line: cmd_daily re-invokes the script this way so
    # the capture runs with errexit genuinely armed. Safe to run by hand.
    __capture) git_capture ;;
    # A stale result is an intentional non-zero exit, NOT an unexpected error:
    # leaving the ERR trap armed made die() fire a second, misleading alert.
    watchdog)  trap - ERR; cmd_watchdog ;;
    substrate) cmd_substrate ;;
    media)     cmd_media ;;
    check)     shift; cmd_check "${1:-}" ;;
    # Pass every argument through, so cmd_rehearsal sees a true $# and can
    # reject what it does not recognise rather than defaulting to Hetzner.
    rehearsal) shift; cmd_rehearsal "$@" ;;
    status)    cmd_status ;;
    prune)     shift; restic_rw "$@" ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \?//' ;;
    *)         echo "usage: tp-backup {daily|substrate|check [--read-data]|rehearsal [--ssd]|status|watchdog|prune ...}" >&2; exit 2 ;;
esac
