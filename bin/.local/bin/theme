#!/usr/bin/env python3
"""theme — switch the desktop palette.

    theme              re-apply the current palette
    theme <name>       switch to <name>
    theme --list       list the palettes
    theme --no-icons   skip papirus-folders (it needs sudo; use in scripts)

Every colour in the desktop comes from palettes.toml. Each `*.tmpl` in the repo
is rendered against the chosen palette and written beside itself with `.tmpl`
stripped: `colors.gen.css.tmpl` -> `colors.gen.css`. The rendered files are
build artefacts — git ignores them, and editing one is pointless because the
next switch overwrites it. Edit the template, or the table.

Why Python, when this was sh: rendering needs a TOML parser and templating, and
sh has neither. sh also has no function-local variables, which cost this script
a real bug once (CLAUDE.md records it).
"""

import os
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

PLACEHOLDER = re.compile(r"\{\{([a-z0-9_]+)\}\}")


def die(msg):
    print(f"theme: {msg}", file=sys.stderr)
    raise SystemExit(1)


def state_file():
    """Where the active palette is remembered.

    $XDG_STATE_HOME (default ~/.local/state), not the repo. Which palette is
    applied is a property of this machine right now, not of the configuration,
    and state does not belong in a source tree — putting it there also made the
    checkout load-bearing for something that has nothing to do with the repo.
    """
    base = os.environ.get("XDG_STATE_HOME") or "~/.local/state"
    return Path(base).expanduser() / "theme" / "palette"


def read_state(root):
    """The remembered palette, migrating the old in-repo .theme if present."""
    path = state_file()
    if path.is_file():
        return path.read_text().strip() or None
    legacy = root / ".theme"
    if legacy.is_file():
        name = legacy.read_text().strip()
        if name:
            write_state(name)
            legacy.unlink()          # migrate once, then stop looking here
            print(f"  migrated .theme -> {path}")
            return name
    return None


def write_state(name):
    path = state_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(name + "\n")


def repo_root():
    """The repo, found from this script even when it is a stow symlink."""
    here = Path(__file__).resolve()          # .../dotfiles/bin/.local/bin/theme
    root = here.parents[3]
    if not (root / "palettes.toml").is_file():
        die(f"cannot find palettes.toml above {here}")
    return root


def flatten(palette, prefix=""):
    """{'ansi': {'normal_red': '#x'}} -> {'ansi_normal_red': '#x'}"""
    out = {}
    for key, val in palette.items():
        if isinstance(val, dict):
            out.update(flatten(val, f"{prefix}{key}_"))
        else:
            out[f"{prefix}{key}"] = val
    return out


def load_palettes(root):
    with open(root / "palettes.toml", "rb") as fh:
        data = tomllib.load(fh)
    names = sorted(data)
    if len(names) < 2:
        die("palettes.toml defines fewer than two palettes")
    # Every palette must carry the same keys. This is why the old runtime
    # role-parity check is gone: a role missing from one palette is now a
    # missing key, named here, instead of a colour that renders as silent
    # black in GTK CSS.
    shapes = {n: set(flatten(data[n])) for n in names}
    first = names[0]
    for other in names[1:]:
        missing, extra = shapes[first] - shapes[other], shapes[other] - shapes[first]
        if missing or extra:
            die(f"{other} and {first} define different keys: "
                f"missing={sorted(missing)} extra={sorted(extra)}")
    return data


def bindings(palette, name):
    """Every key, plus:

    `<key>_hex`  the colour without its leading # — foot and fuzzel want that.
    `palette`    the palette's own name — vim and nvim name their colourscheme
                 rather than listing its colours.
    """
    flat = flatten(palette)
    out = dict(flat, palette=name)
    for key, val in flat.items():
        if isinstance(val, str) and val.startswith("#"):
            out[f"{key}_hex"] = val[1:]
    return out


def render(text, values, where):
    def sub(match):
        key = match.group(1)
        if key not in values:
            die(f"{where}: no such role '{key}' in this palette")
        return values[key]
    return PLACEHOLDER.sub(sub, text)


def apply_theme(root, name, data):
    """Render every template, then write. In that order, deliberately.

    Writing as we go would leave a tree half in one palette and half in the
    other the moment a late template named a role this palette lacks — a state
    no amount of re-running fixes until the template is corrected, and one the
    desktop would happily display. Rendering everything first makes the whole
    switch succeed or change nothing.
    """
    values = bindings(data[name], name)
    pending = []
    for tmpl in sorted(p for p in root.rglob("*.tmpl") if ".git" not in p.parts):
        out = tmpl.with_suffix("")            # strip .tmpl; the rest is the name
        pending.append((out, render(tmpl.read_text(), values, tmpl.relative_to(root))))

    for out, rendered in pending:
        # Never write THROUGH a symlink. A leftover pointer from the old scheme
        # would carry the write to its target and silently edit a tracked file.
        if out.is_symlink():
            out.unlink()
        elif out.exists() and out.read_text() == rendered:
            continue
        out.write_text(rendered)
    write_state(name)
    print(f"  {len(pending)} files rendered from palettes.toml [{name}]")


def run_ok(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def reload_desktop(home):
    """sway reload also restarts waybar, re-runs import-gsettings and nwg-drawer."""
    if shutil.which("swaymsg") and run_ok(["swaymsg", "-t", "get_version"]):
        if not run_ok(["sway", "--validate", "-c", str(home / ".config/sway/config")]):
            die("sway config is invalid; not reloading")
        if run_ok(["swaymsg", "reload"]):
            print("  sway, waybar, nwg-drawer, gsettings  reloaded")
        else:
            print("  swaymsg reload FAILED; the rendered files are in place "
                  "but the desktop still shows the old palette")
    else:
        print("  sway not running; skipped")
    # mako is exec'd, not exec_always'd, so a sway reload does not restart it.
    if shutil.which("makoctl") and run_ok(["makoctl", "reload"]):
        print("  mako                                  reloaded")
    reload_kitty()


def reload_kitty():
    """kitty re-reads kitty.conf and its include on SIGUSR1.

    This is the one terminal here that can change palette without being
    restarted, so it is the one terminal this script signals. foot has no
    reload at all (PLAYBOOK §9.11) and is deliberately left alone: nothing in
    this repo restarts a terminal, because the processes inside one are the
    user's, not ours.

    Sent through kitty's own reload_conf_in_all_kitties() rather than
    `pkill -USR1 -x kitty`, and that is not fussiness. `kitty @ ...` and
    `kitty +...` helper processes share the basename `kitty` and do NOT
    install a SIGUSR1 handler, so pkill would match them and the default
    action for SIGUSR1 — terminate — would kill them. kitty's own function
    filters to GUI processes (kitty/utils.py: is_kitty_gui_cmdline), so using
    it means that filter can never drift from what kitty actually is.
    """
    if not shutil.which("kitty"):
        return
    if run_ok(["kitty", "+runpy",
               "from kitty.utils import reload_conf_in_all_kitties as r; r()"]):
        print("  kitty                                 reloaded (SIGUSR1)")


def reload_icons(values):
    """papirus-folders writes into /usr/share/icons — the one step needing root."""
    wanted = values.get("papirus_folder")
    if not wanted or not shutil.which("papirus-folders"):
        return
    listing = subprocess.run(["papirus-folders", "-l"], capture_output=True, text=True)
    for line in listing.stdout.splitlines():
        if line.strip().startswith(">") and line.split()[-1] == wanted:
            return                            # already this colour
    if not sys.stdin.isatty():
        print("  papirus-folders needs sudo; skipped (not a terminal)")
        return
    subprocess.run(["sudo", "papirus-folders", "-C", wanted, "--theme", "Papirus-Dark"])


def main(argv):
    root = repo_root()
    data = load_palettes(root)
    want_icons, name = True, None
    for arg in argv:
        if arg == "--no-icons":
            want_icons = False
        elif arg == "--list":
            print("\n".join(sorted(data)))
            return 0
        elif arg.startswith("-"):
            die(f"unknown option {arg}")
        elif name is None:
            name = arg
        else:
            die("give at most one palette")

    if name is None:
        name = read_state(root)
        if name is None:
            die(f"no palette given and none remembered yet; "
                f"try: theme {sorted(data)[0]}")
    if name not in data:
        die(f"no palette named '{name}' (have: {', '.join(sorted(data))})")

    apply_theme(root, name, data)
    reload_desktop(Path(os.path.expanduser("~")))
    if want_icons:
        reload_icons(bindings(data[name], name))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
