### Input configuration
#
# Read `man 5 sway-input` for more information about this section.

# Touchpad configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

# Enable numlock by default
input type:keyboard xkb_numlock enabled

# Cursor. Must match gtk-cursor-theme-name in the gtk package's settings.ini
# and ~/.icons/default/index.theme — those three cover GTK apps, the sway
# cursor, and XWayland clients respectively. Deliberately NOT per-theme:
# Qogir-Dark is neutral grey and works against both palettes.
seat * xcursor_theme Qogir-Dark 24

# Lid switch. The machine has a 0:5:Lid_Switch input that stock left unhandled,
# so closing the lid left the internal panel enabled and rendering.
#
# --locked so it still works while swaylock is up; --reload so the binding
# survives a config reload. Closing the lid with an external display attached
# moves everything to that display rather than suspending.
bindswitch --reload --locked lid:on  output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

# Set keyboard layout and variant based on current system settings
exec_always {
    'swaymsg input type:keyboard xkb_layout "$(localectl status | grep "X11 Layout" | sed -e "s/^.*X11 Layout://")"'
    'swaymsg input type:keyboard xkb_variant "$(localectl status | grep "X11 Variant" | sed -e "s/^.*X11 Variant://")"'
}

