# Apply gtk theming
exec_always ~/.config/sway/scripts/import-gsettings

# Set inner/outer gaps
gaps inner 2
gaps outer 0

# Hide titlebar on windows:
default_border pixel 1

# Default Font. The Nerd Font variant, not plain "JetBrains Mono" — sway renders
# window titles and the resize/mode indicator with this, and both can carry the
# same glyphs waybar uses.
font pango:JetBrainsMono Nerd Font 10

# Thin borders:
smart_borders on

# Set wallpaper. Replaces ~/.azotebg, which was an untracked loose script.
# Note azote (the GUI wallpaper picker) rewrites ~/.azotebg when used, so if the
# background ever reverts to an image, that is why.
exec ~/.config/sway/scripts/wallpaper.sh

# Title format for windows
for_window [shell="xdg_shell"] title_format "%title (%app_id)"
for_window [shell="x_wayland"] title_format "%class - %title"

# Nord. Replaces the stock EndeavourOS Dracula palette (#6272A4 / #282A36 /
# #F8F8F2). Convention used across every config in this repo:
#   nord8  #88C0D0  focus / active accent
#   nord3  #4C566A  inactive but not idle
#   nord1  #3B4252  unfocused chrome
#   nord11 #BF616A  urgent / critical
#   nord0  #2E3440  background      nord4 #D8DEE9  foreground
#
# Backgrounds are nord0 rather than matching the border colour: the stock config
# set bground == border, which paints the whole titlebar area in the accent.
#
# class                 border  bground text    indicator child_border
client.focused          #88C0D0 #2E3440 #ECEFF4 #8FBCBB   #88C0D0
client.focused_inactive #4C566A #2E3440 #D8DEE9 #4C566A   #4C566A
client.unfocused        #3B4252 #2E3440 #4C566A #3B4252   #3B4252
client.urgent           #BF616A #BF616A #ECEFF4 #BF616A   #BF616A
client.placeholder      #3B4252 #2E3440 #D8DEE9 #3B4252   #3B4252
client.background       #2E3440

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    swaybar_command waybar
}
