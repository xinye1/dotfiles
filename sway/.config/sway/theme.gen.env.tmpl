# Generated from palettes.toml by `theme` — do not edit; edit the .tmpl.
# the fourteen theme roles as shell variables.
#
# variable names. `theme` refuses to switch if they diverge.
#

BG={{bg}}
SURFACE={{surface}}
SEL={{sel}}
MUTED={{muted}}
DIM={{dim}}
FG={{fg}}
FG_BRIGHT={{fg_bright}}
ACCENT={{accent}}
ACCENT2={{accent2}}
INDICATOR={{indicator}}
CRITICAL={{critical}}
WARNING={{warning}}
SUCCESS={{success}}

# One shade below `bg`, which is what turns the gaps between windows into
# visible channels. palettes.toml records how each palette arrives at it.
DESKTOP={{desktop}}

# The papirus-folders colour closest to this palette's accent.
PAPIRUS_FOLDER={{papirus_folder}}

# The GTK theme installed for this palette; see PLAYBOOK.md §8.
GTK_THEME_NAME={{gtk_theme_name}}
