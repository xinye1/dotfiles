# Generated from palettes.toml by `theme` — do not edit; edit the .tmpl.
# fuzzel's colours. Alpha is significant here: the launcher is
# translucent (background ...ee), everything else fully opaque (...ff).
#
# Included directly by fuzzel.ini as `colors.gen.ini`; `theme` renders it.
# fuzzel reads its config at launch, so a switch applies to the next
# invocation with no reload needed.

[colors]
background={{bg_hex}}ee
text={{fg_hex}}ff
placeholder={{muted_hex}}ff
prompt={{accent_hex}}ff
input={{fg_bright_hex}}ff
match={{warning_hex}}ff
selection-match={{warning_hex}}ff
selection={{sel_hex}}ff
selection-text={{fg_bright_hex}}ff
counter={{muted_hex}}ff
border={{accent_hex}}ff
