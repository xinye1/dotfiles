/* Generated from palettes.toml by `theme` — do not edit; edit the .tmpl. */
/* the fourteen theme roles as GTK named colours.
 * A name defined in only one renders as black with no error. */

@define-color bg        {{bg}};
@define-color surface   {{surface}};
@define-color sel       {{sel}};
@define-color muted     {{muted}};
@define-color dim       {{dim}};
@define-color fg        {{fg}};
@define-color fg_bright {{fg_bright}};
@define-color accent    {{accent}};
@define-color accent2   {{accent2}};
@define-color indicator {{indicator}};
@define-color critical  {{critical}};
@define-color warning   {{warning}};
@define-color success   {{success}};
@define-color desktop   {{desktop}};
