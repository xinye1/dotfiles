/* Generated from palettes.toml by `theme` — do not edit; edit the .tmpl. */
/* GTK3 user overrides — loaded after the palette's GTK theme.
 *
 * Kept deliberately small. The theme does the work; this only pins the accent
 * so selections match sway's focus border exactly. */

@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{bg}};

selection {
  background-color: {{accent}};
  color: {{bg}};
}
