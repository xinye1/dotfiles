# Generated from palettes.toml by `theme` — do not edit; edit the .tmpl.
# scripts/import-gsettings pushes the values into gsettings on every reload.
#
# settings.ini has no include mechanism, so the whole file is switched. The
# non-colour half (fonts, hinting, toolbar) is duplicated into
# gtk-4.0/settings.ini.tmpl — or rather, the part of it GTK4 still reads is:
# gtk-icon-theme-name, gtk-font-name, gtk-cursor-theme-name,
# gtk-cursor-theme-size and gtk-application-prefer-dark-theme, byte-identical
# there. The toolbar, button/menu-image, event-sound and Xft keys below are
# GTK3-only, have no GTK4 counterpart, and are deliberately absent from it.
# Only gtk-theme-name carries a placeholder — change a font or a cursor here
# and it has to change there too, because nothing checks the two agree.
[Settings]
gtk-theme-name={{gtk_theme_name}}
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Noto Sans 10
gtk-cursor-theme-name=Qogir-Dark
gtk-cursor-theme-size=24
gtk-toolbar-style=GTK_TOOLBAR_BOTH_HORIZ
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=0
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
gtk-application-prefer-dark-theme=1
